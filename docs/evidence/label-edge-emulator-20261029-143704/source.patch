+                TextLine("Warnings: Do not take with warfarin.", 0.95f, block = 1),
+                TextLine(continuation, 0.95f, block = 2),
+                TextLine("Hypericum perforatum (St John's Wort) 300 mg", 0.95f, block = 3),
+            ))
